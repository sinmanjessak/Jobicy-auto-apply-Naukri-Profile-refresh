# Copy this file to .env and fill in only the values you need.
# Do not commit .env, passwords, cookies, or browser profiles.
NAUKRI_BASE_URL=https://www.naukri.com/
RESUME_PATH=./data/resume.pdf
DATABASE_PATH=./data/naukri_automation.sqlite3
LOG_LEVEL=INFO
# Keep submission disabled until you have reviewed the workflow.
LIVE_SUBMISSION=false
# Local timezone for reports and future scheduling.
TIMEZONE=Asia/Kolkata
PROFILE_REVIEW_CURRENT_DAYS=30
PROFILE_REVIEW_DUE_DAYS=90
PROFILE_REFRESH_HOUR=9
PROFILE_REFRESH_MINUTE=0
# Optional job filters, comma-separated
TARGET_ROLES=SDE,Backend,Artificial Intelligence Engineer,Fullstack Developer,Data Analyst,Data Scientist,Python Developer,DotNet Developer
NOTICE_PERIOD_PREFERENCE=Immediate joiner
SALARY_PREFERENCE=Flexible for the right role
TARGET_LOCATIONS=India,Remote,Bengaluru,Hyderabad,Pune,Gurugram,Noida
MIN_MATCH_SCORE=60
# Explainable local matching weights must total 100; mismatch penalty is points.
MATCH_ROLE_WEIGHT=25
MATCH_SKILL_WEIGHT=55
MATCH_EXPERIENCE_WEIGHT=20
MATCH_MISMATCH_PENALTY=20
# Jobicy public API: at most this many results per configured role; discovery is one run/hour max.
JOBICY_RESULTS_PER_ROLE=5
JOBICY_REQUEST_TIMEOUT_SECONDS=15
JOBICY_TOTAL_TIMEOUT_SECONDS=60
